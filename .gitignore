# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js build output
/.next
/out

# Production
/build

# Vercel
.vercel

# Static exports
/dist

# Misc
.DS_Store
*.pem

#
# Environment variables
#
# IMPORTANT: Never commit your secret keys to a public repository.
# Today .env.local holds only NEXT_PUBLIC_* values, which are meant to reach
# the browser — but keep it ignored so the first genuine secret added here is
# not committed by accident.
.env.local
.env.development.local
.env.test.local
.env.production.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Security audit — kept out of the public repo; it details unfixed weaknesses.
docs/security-audit.md

# graphify knowledge graph (generated locally)
graphify-out/

# Incremental typecheck cache — a build artifact, regenerated by `npx tsc`.
tsconfig.tsbuildinfo

# Per-machine Claude Code permissions. .claude/settings.json is shared on
# purpose (it wires the graphify hooks); the .local file is not.
.claude/settings.local.json

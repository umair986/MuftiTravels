# This is an example file.
# DO NOT put your actual API key in this file.
#
# Create a new file named .env.local and add your secret key there.
# The .env.local file is ignored by Git (see .gitignore).

RESEND_API_KEY=your_resend_api_key_goes_here
# Replace 'your_resend_api_key_goes_here' with your actual Resend API key.
# You can find your API key in the Resend dashboard.
# Make sure to keep this key secret and do not share it publicly.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SITE_URL=https://muftitravels.vercel.app

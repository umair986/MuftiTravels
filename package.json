{
  "name": "mufti-travels",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test src/lib/*.test.ts",
    "test:pdf": "esbuild scripts/render-invoice-check.mts --bundle --platform=node --format=esm --target=node22 --jsx=automatic --external:pdfkit --outfile=node_modules/.cache/mt/render-check.mjs --log-level=error && node node_modules/.cache/mt/render-check.mjs",
    "sample:pdf": "esbuild scripts/render-invoice-sample.mts --bundle --platform=node --format=esm --target=node22 --jsx=automatic --external:pdfkit --external:sharp --outfile=node_modules/.cache/mt/render-sample.mjs --log-level=error && node node_modules/.cache/mt/render-sample.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.6",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^12.16.0",
    "lucide-react": "^0.514.0",
    "next": "15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
